# ─────────────────────────────────────────────────────────────────────────────
#  CEDAE Inovação — template de variáveis de ambiente
#
#  Como usar:
#    cp .env.example .env        (nunca commite o arquivo .env)
#    cp .env.example backend/.env
#
#  Credenciais Oracle: solicitar ao DBA (bl202.cedae.corp)
#  Autenticação: login direto no Active Directory via LDAPS (usuário + senha).
#                A sessão é mantida por cookie httpOnly (JWT). Ver seção LDAP.
# ─────────────────────────────────────────────────────────────────────────────

# ── Conexão Oracle ────────────────────────────────────────────────────────────
ORACLE_HOST=<host-oracle-aqui>
ORACLE_PORT=1521
ORACLE_SERVICE=<service-name-aqui>
ORACLE_USER=<usuario-oracle-aqui>
ORACLE_PASSWORD=<senha-oracle-aqui>

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8095

# Prefixo de todas as rotas (backend e frontend). Ex.: "inovacao" faz a
# aplicação responder em /inovacao. Deixe vazio para servir na raiz "/".
PROJECT_PATH=inovacao

# ── Autenticação LDAP / Active Directory (LDAPS) ─────────────────────────────
# Servidor LDAP. Use ldaps:// (porta 636) para tráfego cifrado.
LDAP_HOST=ldaps://dns3.cedae.corp
LDAP_PORT=636

# Base de busca do diretório (onde o usuário é procurado pelo sAMAccountName).
LDAP_BASE_DN=DC=cedae,DC=corp

# Domínio NetBIOS usado no bind (formato DOMINIO\usuario). Ex.: CEDAE.
LDAP_DOMAIN=CEDAE

# (Opcional) Grupo do AD exigido para acessar o sistema. Vazio = qualquer
# usuário autenticado no AD pode entrar (a autorização de admin continua sendo
# feita pela tabela ADMIN_USERS). Ex.: sistemas.dev
LDAP_GROUP=

# (Opcional) Caminho do certificado da CA que assinou o cert do servidor LDAPS.
# Necessário quando LDAP_TLS_REQUIRE_CERT=demand e a CA não é pública.
LDAP_CA_FILE=

# Validação do certificado TLS do servidor:
#   allow  → conecta mesmo com certificado não confiável (default)
#   demand → exige certificado válido (recomendado em produção, com LDAP_CA_FILE)
LDAP_TLS_REQUIRE_CERT=allow

# Timeout de rede do LDAP em milissegundos (conexão e operações).
LDAP_NETWORK_TIMEOUT=8000

# ── Sessão (JWT em cookie httpOnly) ──────────────────────────────────────────
# Segredo de assinatura do token de sessão. DEFINA em produção (string longa
# e aleatória). Sem ele, um segredo efêmero é gerado e as sessões caem a cada
# reinício do serviço.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
# Validade da sessão em segundos (default 28800 = 8h).
SESSION_TTL=28800
# Marque o cookie como Secure (só trafega em HTTPS). Use true em produção.
SESSION_COOKIE_SECURE=false

# ── Desenvolvimento local ─────────────────────────────────────────────────────
# Fallback de identidade para desenvolvimento SEM AD: quando não há cookie de
# sessão nem header, o sistema assume este login e consulta ADMIN_USERS.
# Mantido por compatibilidade (também aceita o header x-remote-user legado).
# Remover (ou deixar vazio) para exigir login real via AD.
DEV_REMOTE_USER=gsalviete

# ── Rate limiting (requisições por IP) ───────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── E-mail (SMTP) — confirmação automática da Via 2 (ADR-014 §12) ─────────────
# Liga/desliga todo o envio de e-mail. Deixe false em dev sem SMTP.
MAIL_ENABLED=false
# Servidor SMTP e credenciais (solicitar à equipe de infraestrutura).
SMTP_HOST=
SMTP_PORT=587
# true para conexão TLS implícita (porta 465); false para STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente institucional exibido no e-mail (durante os testes: bi.7@cedae.com.br).
MAIL_FROM=bi.7@cedae.com.br
MAIL_FROM_NAME=CEDAE Inovação

# ── Termos e Condições de Uso (ADR-014 §12-bis) ──────────────────────────────
# Versão vigente dos termos. Ao incrementar, o aceite é solicitado novamente.
TERMOS_VERSAO=1.0
