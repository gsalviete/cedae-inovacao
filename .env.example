# ─────────────────────────────────────────────────────────────────────────────
#  CEDAE Inovação — template de variáveis de ambiente
#
#  UM AMBIENTE, UM ARQUIVO. O app carrega exatamente um (backend/src/env.ts):
#
#    ENV_FILE=/caminho/arquivo ... vence tudo (teste pontual)
#    NODE_ENV=production ........ .env       ← todo container (o Dockerfile define)
#    qualquer outro caso ........ .env.dev, e .env só se .env.dev não existir
#
#  Os dois NUNCA são lidos em cascata: uma variável ausente do .env.dev cairia
#  no valor de produção sem avisar — é assim que uma máquina de desenvolvimento
#  escreve no banco de produção.
#
#  Como usar:
#    cp .env.example .env         # produção / container
#    cp .env.example .env.dev     # sua máquina
#
#  Nunca commite nenhum dos dois (o .gitignore já bloqueia .env e .env.*) e não
#  crie backend/.env: o Dockerfile copia backend/ para dentro da imagem.
#
#  NODE_ENV não pode ser definido aqui dentro — é ele que escolhe este arquivo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Conexão Oracle ────────────────────────────────────────────────────────────
# Destino sempre em Easy Connect, montado como HOST:PORT/SERVICE. Não há mais
# ORACLE_CONNECT_STRING nem tnsnames.ora dentro do container: em produção o host
# é o SCAN do RAC (ora-prod-scan.cedae.corp → 10.10.0.182/183/184) e o próprio
# listener redireciona para o nó vivo, que era o único ganho do descritor TNS.
#
#   testes ..... bl202.cedae.corp:1521/cedaetst.cedae.corp
#   produção ... ora-prod-scan.cedae.corp:1521/cedae.cedae.corp
#
# Sem HOST/SERVICE o app não inventa destino: falha dizendo o nome que falta.
ORACLE_USER=<usuario-oracle-aqui>
ORACLE_PASSWORD=<senha-oracle-aqui>
ORACLE_HOST=<host-oracle-aqui>
ORACLE_PORT=1521
ORACLE_SERVICE=<service-name-aqui>

# ── Servidor ──────────────────────────────────────────────────────────────────
# Dentro do container precisa continuar 8095: é o EXPOSE da imagem e o
# mapeamento fixo do docker-compose.
PORT=8095

# Prefixo de todas as rotas (backend, páginas e estáticos). Ex.: "esteira_inovacao"
# faz a aplicação responder em /esteira_inovacao. Vazio serve na raiz "/".
# O app funciona com o proxy repassando ou removendo o prefixo.
PROJECT_PATH=esteira_inovacao

# ── Identidade ────────────────────────────────────────────────────────────────
# Não há login nem sessão na aplicação: o IIS autentica no AD (Kerberos) e
# injeta o header `x-remote-user` em toda requisição. A autorização continua
# vindo da tabela ADMIN_USERS.
#
# Esta variável é o fallback para requisições SEM esse header — a máquina do
# desenvolvedor, que não tem IIS na frente. Em produção significa que quem
# falar direto com o container, sem passar pelo proxy, é atendido como este
# usuário; o app avisa no boot e no /api/health quando ela existe com
# NODE_ENV=production.
DEV_REMOTE_USER=

# ── Rate limiting (requisições por IP) ───────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── E-mail (SMTP) — confirmação automática da Via 2 (ADR-014 §12) ─────────────
#
# Dois namespaces, cada um por um motivo:
#
#   SMTP_*  ............... transporte, com o nome nu. Nada colide: o cron de
#                           notificação de deploy da infra usa SMTP_SERVER, que
#                           não é SMTP_HOST.
#   INOVACAO_MAIL_FROM* ... remetente, COM prefixo. MAIL_FROM e MAIL_FROM_NAME
#                           existem no ambiente dos servidores
#                           (MAIL_FROM=deploy@cedae.com.br) e já fizeram e-mail
#                           da Via 2 sair assinado como deploy@. O prefixo é o
#                           que impede a herança silenciosa.
#
# Os nomes antigos (INOVACAO_SMTP_*, INOVACAO_MAIL_ENABLED) não são mais lidos.
# Se ficarem para trás no Portainer, o envio para — e o app denuncia, no log de
# boot e em /api/health, com o par "nome antigo → nome novo".
#
# Liga/desliga todo o envio (false em ambiente sem acesso ao relay).
SMTP_ENABLED=false
# Relay interno (guandu-mirim): libera por whitelist de IP, sem autenticação.
# Prefira o nome ao IP — smtp.cedae.corp resolve para 10.10.0.128 na rede de
# desenvolvimento e nos servidores, e sobrevive a uma troca de IP do relay.
SMTP_HOST=smtp.cedae.corp
SMTP_PORT=25
# true para TLS implícito (porta 465); false para STARTTLS (25/587).
SMTP_SECURE=false
# Exigir cadeia de certificado confiável no STARTTLS. Deixe false para o relay
# interno (certificado de CA própria); true quando houver CA publicável.
SMTP_TLS_REJECT_UNAUTHORIZED=false
# Não há SMTP_USER/SMTP_PASS: o relay libera por whitelist de IP e o app envia
# sem autenticar. Um relay que exigisse credencial pediria mudança no código.
# Remetente institucional exibido no e-mail. NÃO use aspas: o valor é literal, e
# aspas aqui entram no header From (foi o que aconteceu com a variável do host).
INOVACAO_MAIL_FROM=bi.7@cedae.com.br
INOVACAO_MAIL_FROM_NAME=CEDAE Inovação

# ── Termos e Condições de Uso (ADR-014 §12-bis) ──────────────────────────────
# Versão vigente dos termos. Ao incrementar, o aceite é solicitado novamente.
# 2.0 = texto substituído pelo aviso de privacidade LGPD aprovado.
TERMOS_VERSAO=2.0
