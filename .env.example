# ─────────────────────────────────────────────────────────────────────────────
#  CEDAE Inovação — template de variáveis de ambiente
#
#  Como usar:
#    cp .env.example .env        (nunca commite o arquivo .env)
#    cp .env.example backend/.env
#
#  Credenciais Oracle: solicitar ao DBA (bl202.cedae.corp)
#  Autenticação: login direto no Active Directory via LDAPS (usuário + senha).
#                A sessão é mantida por cookie httpOnly (JWT). Ver seção LDAP.
# ─────────────────────────────────────────────────────────────────────────────

# ── Conexão Oracle ────────────────────────────────────────────────────────────
ORACLE_USER=<usuario-oracle-aqui>
ORACLE_PASSWORD=<senha-oracle-aqui>

# Destino da conexão. Se ORACLE_CONNECT_STRING estiver preenchida, ela vence e
# o trio HOST/PORT/SERVICE é ignorado. Três formas aceitas:
#
#   1) Easy Connect (banco de testes, o que sempre usamos):
#      ORACLE_CONNECT_STRING=bl202.cedae.corp:1521/ORCLPDB1
#
#   2) Descritor TNS inline — copie o conteúdo entre parênteses da entrada do
#      tnsnames.ora, tudo numa linha só. É a forma recomendada para produção:
#      não depende de arquivo nenhum dentro do container e suporta failover /
#      múltiplos ADDRESS normalmente. Este é o valor real de produção, igual à
#      entrada CEDAE.CEDAE.CORP do tnsnames.ora (RAC: ora-prod-scan é o SCAN e
#      resolve para 10.10.0.182/183/184; o listener redireciona para o nó vivo):
#      ORACLE_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=ora-prod-scan.cedae.corp)(PORT=1521))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=cedae)))
#
#   3) Alias do tnsnames.ora — exige ORACLE_TNS_ADMIN apontando para o diretório
#      que contém o arquivo (e o arquivo precisa existir lá dentro do container):
#      ORACLE_CONNECT_STRING=PROD_CEDAE
#      ORACLE_TNS_ADMIN=/app/tns
#
ORACLE_CONNECT_STRING=
ORACLE_TNS_ADMIN=

# Usados apenas quando ORACLE_CONNECT_STRING está vazia.
ORACLE_HOST=<host-oracle-aqui>
ORACLE_PORT=1521
ORACLE_SERVICE=<service-name-aqui>

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8095

# Prefixo de todas as rotas (backend e frontend). Ex.: "inovacao" faz a
# aplicação responder em /inovacao. Deixe vazio para servir na raiz "/".
PROJECT_PATH=inovacao

# ── Desenvolvimento local ─────────────────────────────────────────────────────
# Fallback de identidade para desenvolvimento SEM AD: quando não há cookie de
# sessão nem header, o sistema assume este login e consulta ADMIN_USERS.
# Mantido por compatibilidade (também aceita o header x-remote-user legado).
# Remover (ou deixar vazio) para exigir login real via AD.
DEV_REMOTE_USER=gsalviete

# ── Rate limiting (requisições por IP) ───────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── E-mail (SMTP) — confirmação automática da Via 2 (ADR-014 §12) ─────────────
#
# TODAS as variáveis de e-mail usam o prefixo INOVACAO_ e SÓ ele. Não é estilo:
# os servidores já definem MAIL_ENABLED, MAIL_FROM, MAIL_FROM_NAME e
# SMTP_SERVER no ambiente do host, para o cron de notificação de deploy da
# infra. O app chegou a herdar esses valores — SMTP_SERVER não é SMTP_HOST,
# então SMTP_HOST ficava indefinida e nenhum e-mail da Via 2 saía; se saísse,
# sairia assinado como deploy@cedae.com.br.
#
# O prefixo elimina a colisão e faz este bloco valer igual na máquina do
# desenvolvedor e no Portainer, sem ajuste. Os nomes sem prefixo NÃO são mais
# lidos pelo app — se aparecerem, são do servidor e devem ficar como estão.
#
# Liga/desliga todo o envio (false em dev sem acesso ao relay).
INOVACAO_MAIL_ENABLED=false
# Relay interno (guandu-mirim): libera por whitelist de IP, sem autenticação.
# Prefira o nome ao IP — smtp.cedae.corp resolve para 10.10.0.128 na rede de
# desenvolvimento e nos servidores, e sobrevive a uma troca de IP do relay.
INOVACAO_SMTP_HOST=smtp.cedae.corp
INOVACAO_SMTP_PORT=25
# true para TLS implícito (porta 465); false para STARTTLS (25/587).
INOVACAO_SMTP_SECURE=false
# Exigir cadeia de certificado confiável no STARTTLS. Deixe false para o relay
# interno (certificado de CA própria); true quando houver CA publicável.
INOVACAO_SMTP_TLS_REJECT_UNAUTHORIZED=false
# Credenciais: deixe vazias quando o relay libera por IP (o envio vai sem auth).
INOVACAO_SMTP_USER=
INOVACAO_SMTP_PASS=
# Remetente institucional exibido no e-mail. NÃO use aspas: o valor é literal, e
# aspas aqui entram no header From (foi o que aconteceu com a variável do host).
INOVACAO_MAIL_FROM=bi.7@cedae.com.br
INOVACAO_MAIL_FROM_NAME=CEDAE Inovação

# ── Termos e Condições de Uso (ADR-014 §12-bis) ──────────────────────────────
# Versão vigente dos termos. Ao incrementar, o aceite é solicitado novamente.
# 2.0 = texto substituído pelo aviso de privacidade LGPD aprovado.
TERMOS_VERSAO=2.0
