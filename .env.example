# ─────────────────────────────────────────────────────────────────────────────
#  CEDAE Inovação — template de variáveis de ambiente
#
#  Como usar:
#    cp .env.example .env        (nunca commite o arquivo .env)
#    cp .env.example backend/.env
#
#  Credenciais Oracle: solicitar ao DBA (bl202.cedae.corp)
#  JWT_SECRET: gerar com  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Conexão Oracle ────────────────────────────────────────────────────────────
# Solicitar ao DBA: host, porta, service name, usuário e senha do schema de inovação
ORACLE_HOST=<host-oracle-aqui>
ORACLE_PORT=1521
ORACLE_SERVICE=<service-name-aqui>
ORACLE_USER=<usuario-oracle-aqui>
ORACLE_PASSWORD=<senha-oracle-aqui>

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatórios — gerar com o comando acima
JWT_SECRET=<gerar-com-crypto-randomBytes-32>
JWT_EXPIRES_IN=60m

# ── Credenciais do administrador ──────────────────────────────────────────────
# Usuário e senha para acesso ao painel admin (substituir pelo login real)
ADMIN_USERNAME=<login-do-administrador>
ADMIN_PASSWORD=<senha-forte-aqui>

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8095

# ── Rate limiting (POST /api/auth/login) ──────────────────────────────────────
# RATE_LIMIT_TTL: janela de tempo em segundos
# RATE_LIMIT_MAX: máximo de tentativas na janela — após atingir, retorna 429
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=5
